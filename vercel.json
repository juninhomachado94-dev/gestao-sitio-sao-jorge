{
  "version": 2,
  "name": "gestao-sitio-sao-jorge",
  "alias": [
    "gestao-sitio-sao-jorge.vercel.app"
  ],
  "public": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
